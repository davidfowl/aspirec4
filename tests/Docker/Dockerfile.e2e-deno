# Test runner environment for deno-based local CLI integration tests.
#
# Runs Docker-in-Docker (DinD) so that redis/postgres containers used by the
# TestAppHost start correctly. The LikeC4 server itself is driven by deno instead
# of a Docker container, exercising the WithLocalCLI(LocalCLIRuntime.Deno) path.
# ASPIREC4_CLI_RUNTIME=Deno causes the TestAppHost to call .WithLocalCLI(Deno) at startup.
#
# Node.js is still installed because the TestAppHost uses AddNodeApp/.WithNpm(install:true)
# which requires npm for the sample node app's dependency installation.
#
# Usage (from repo root):
#   docker build -f tests/Docker/Dockerfile.e2e-deno -t aspirec4-e2e-deno .
#   docker run --rm --privileged \
#     -v $(pwd):/workspace \
#     -w /workspace \
#     aspirec4-e2e-deno \
#     dotnet test src/tests/AspireC4.IntegrationTests

FROM mcr.microsoft.com/dotnet/sdk:10.0

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        docker.io \
        ca-certificates \
        curl \
        unzip && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    # Install deno via the official installer script.
    curl -fsSL https://deno.land/install.sh | sh && \
    rm -rf /var/lib/apt/lists/*

ENV DENO_INSTALL="/root/.deno"
ENV PATH="$DENO_INSTALL/bin:$PATH"

# Entrypoint: start dockerd (DinD) for redis/postgres containers, wait for readiness,
# then exec the test command. Deno downloads modules on demand so no pre-install step
# is included here; the first run will populate the Deno module cache.
RUN cat > /entrypoint.sh <<'EOF'
#!/bin/bash
set -e

dockerd --host=unix:///var/run/docker.sock --storage-driver=vfs >/var/log/dockerd.log 2>&1 &
DOCKERD_PID=$!

echo "Waiting for Docker daemon..."
for i in $(seq 1 60); do
    docker info >/dev/null 2>&1 && { echo "Docker daemon ready"; break; }
    sleep 1
done

if ! docker info >/dev/null 2>&1; then
    echo "ERROR: Docker daemon not ready after 60s" >&2
    cat /var/log/dockerd.log >&2
    exit 1
fi

exec "$@"
EOF
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

RUN mkdir -p /workspace
WORKDIR /workspace

ENV ASPIREC4_CLI_RUNTIME=Deno
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
ENV DOTNET_GENERATE_ASPNET_CERTIFICATE=false
ENV TERM=xterm

ENTRYPOINT ["/entrypoint.sh"]
