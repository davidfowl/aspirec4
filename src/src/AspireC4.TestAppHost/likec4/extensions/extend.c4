// This file extends the auto-generated model with additional models, documentation, links, and metadata.
// It is intentionally hand-authored.

specification {
	element team {
    style {
      shape person
      color #FF5733
    }
  }

  element system {
    style {
      shape browser 
      color #33C1FF
      icon @/likec4/likec4-wordmark.svg
    }
  }
}

model {
	likec4_team = team 'LikeC4 Contributors' {
		summary 'The team of contributors who created the LikeC4 model and documentation.'
    link https://github.com/likec4/likec4/graphs/contributors 'GitHub Contributors'

		-> likec4 'Created with 🩷 by'
	}

  likec4 = system 'LikeC4' {
    summary 'Describe your system architecture with code. Visualize, validate and share — all from a single source of truth.'
    link https://likec4.dev/ 'Learn more about LikeC4'
    link https://github.com/likec4/likec4/ 'LikeC4 on GitHub'
    link https://github.com/sponsors/likec4 'Sponsor LikeC4 🩷'
    link https://github.com/davydkov 'Connect with the author on GitHub'

    -> aspirec4_server 'used by 🤖'
  }

  extend azure_redis {
    link https://aka.ms/azure-cache-for-redis 'Azure Cache for Redis Docs'
    metadata {
      team 'Platform'
      tier 'data'
    }
  }

  extend azure_postgres {
    link https://aka.ms/azure-postgresql 'Azure PostgreSQL Flexible Server Docs'
    metadata {
      team 'Platform'
      tier 'data'
    }
  }

  extend node_app {
    link https://nodejs.org 'Node.js'
    metadata {
      tier 'app'
    }
  }
}
